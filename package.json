{
  "name": "@nexartis/nexartis-nanda-node-sdk",
  "version": "1.1.0",
  "description": "Official TypeScript SDK for the Nexartis NANDA Node — agent registration, A2A discovery, trust scoring, DAG workflow orchestration, and NANDA Index resolution on the open agentic web (Project NANDA, MIT Media Lab).",
  "homepage": "https://sdk.nandanetwork.link",
  "bugs": {
    "url": "https://github.com/Nexartis/nexartis-nanda-node-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Nexartis/nexartis-nanda-node-sdk.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "docs": "typedoc",
    "docs:serve": "cd typedoc-site && pnpm run dev",
    "size": "size-limit",
    "size:why": "size-limit --why",
    "prepack": "pnpm run clean && pnpm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "nanda",
    "nnn",
    "agent-discovery",
    "a2a",
    "orchestration",
    "routing",
    "nexartis",
    "apache-2.0",
    "oss",
    "cloudflare-workers"
  ],
  "author": "Nexartis, LLC",
  "license": "Apache-2.0",
  "devDependencies": {
    "@size-limit/preset-small-lib": "^12.1.0",
    "@types/node": "^25.5.0",
    "size-limit": "^12.1.0",
    "typedoc": "^0.28.19",
    "typedoc-plugin-mdn-links": "^5.1.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.28.1",
  "pnpm": {
    "overrides": {
      "picomatch": ">=4.0.4",
      "vite": ">=8.0.5"
    }
  }
}
