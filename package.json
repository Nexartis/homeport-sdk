{
  "name": "@nexartis/nexartis-nanda-node-sdk",
  "version": "1.0.0",
  "description": "Typed TypeScript SDK for the Nexartis NANDA Node — agent registry, discovery, DAG orchestration, trust, and A2A interoperability.",
  "homepage": "https://sdk.nandanetwork.link",
  "bugs": {
    "url": "https://github.com/Nexartis/nexartis-nanda-node-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Nexartis/nexartis-nanda-node-sdk.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "nanda",
    "nnn",
    "agent-discovery",
    "a2a",
    "orchestration",
    "routing",
    "nexartis",
    "apache-2.0",
    "oss",
    "cloudflare-workers"
  ],
  "author": "Nexartis",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.28.1"
}
