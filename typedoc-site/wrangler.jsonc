{
	"$schema": "node_modules/wrangler/config-schema.json",
	/*
	 * ===================================================================
	 * HOMEPORT SDK — DOCS SITE WORKER
	 * ===================================================================
	 *
	 * Serves the TypeDoc-generated API reference for @nexartis/homeport-sdk
	 * via a Cloudflare Worker with a static assets binding.
	 *
	 * Homeport is the open-source self-hostable NANDA node published by
	 * Nexartis. This worker serves the SDK documentation only; the runtime
	 * itself lives at github.com/Nexartis/homeport.
	 *
	 * Layout of ./dist after `pnpm run docs` + landing-page copy:
	 *   dist/
	 *     index.html      ← branded landing page (from ./public/index.html)
	 *     api/            ← typedoc output (from root typedoc.json)
	 *
	 * Custom domains:
	 *   env.dev  → homeport-sdk-dev.nexartis.com
	 *   env.prod → homeport-sdk.nexartis.com
	 *
	 * The legacy nnn-sdk[-dev].nexartis.com hostnames are served by the
	 * sibling redirect-worker/ package (301 → homeport-sdk[-dev]) for the
	 * announced deprecation window.
	 *
	 * Deploy conventions (see repo root rules): invoke from the repository root
	 * so the SDK build, TypeDoc output, and landing assets are staged first:
	 *   pnpm run deploy:dev    or    pnpm run deploy:prod
	 * ===================================================================
	 */
	"name": "homeport-sdk-docs",
	"main": "src/worker.ts",
	"compatibility_date": "2025-01-01",
	"compatibility_flags": ["nodejs_compat"],

	// Static Assets binding — serves everything under ./dist to the Worker
	// via the ASSETS binding. Requests fall through to the Worker's fetch()
	// handler only when no matching asset exists (see src/worker.ts).
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},

	// Observability — logs only (no tracing needed for a docs-only worker).
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1.0
		}
	},

	// ===================================================================
	// DEPLOYMENT ENVIRONMENTS
	// ===================================================================
	// Organized by deployment pipeline order: Dev → Prod
	// Each environment is explicit; no root-level routes/vars.
	"env": {
		// ===================================================================
		// 🧪 DEVELOPMENT — homeport-sdk-dev.nexartis.com
		// ===================================================================
		"dev": {
			"name": "homeport-sdk-docs-dev",
			"routes": [
				{
					"pattern": "homeport-sdk-dev.nexartis.com",
					"custom_domain": true
				}
			],
			"vars": {
				"ENVIRONMENT": "development",
				"DOCS_CANONICAL_URL": "https://homeport-sdk-dev.nexartis.com"
			}
		},

		// ===================================================================
		// 🚀 PRODUCTION — homeport-sdk.nexartis.com
		// ===================================================================
		"prod": {
			"name": "homeport-sdk-docs",
			"routes": [
				{
					"pattern": "homeport-sdk.nexartis.com",
					"custom_domain": true
				}
			],
			"vars": {
				"ENVIRONMENT": "production",
				"DOCS_CANONICAL_URL": "https://homeport-sdk.nexartis.com"
			}
		}
	}
}
